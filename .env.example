# ---------------------------------------------------------------------------
# DLang Basketball Club OS — environment template
# Copy to .env.local and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — used by the Stripe webhook & trusted server jobs.
# Must NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App (platform URL). Email/notification links use the club's own host
# (custom domain or https://<slug>.<PLATFORM_ROOT_DOMAIN>); this is only the
# fallback when PLATFORM_ROOT_DOMAIN is unset (single-tenant / local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Payments — M5)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend (Transactional email — M12)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="DLang Basketball <noreply@dlangbasketball.ch>"

# For `npm run types` (Supabase type generation)
SUPABASE_PROJECT_ID=your-project-ref

# White-label tenancy
# Tenants are resolved per request from the Host header:
#   <slug>.<PLATFORM_ROOT_DOMAIN>  or a verified organizations.custom_domain.
# On localhost (or apex/www) DEFAULT_ORG_SLUG is used. Local dev can also use
# http://<slug>.localhost:3000 (e.g. dlang.localhost, riverside.localhost).
PLATFORM_ROOT_DOMAIN=clubos.example
DEFAULT_ORG_SLUG=dlang
# Platform (master) brand shown where no club is known (signup, platform
# console, invoice footer, legal pages). Configurable per deployment; the code
# falls back to the neutral "Club OS". Clubs see their own app name instead
# (Settings -> App & assistant; falls back to the club name).
NEXT_PUBLIC_PLATFORM_NAME="Club OS"
# Staging/demo only: also offer email + password sign-in on /login (demo
# accounts use reserved, undeliverable addresses). Leave unset in production
# (the env checks reject "true" when APP_ENV=production).
NEXT_PUBLIC_AUTH_PASSWORD_LOGIN=

# ---------------------------------------------------------------------------
# SaaS platform layer (white-label operator: plans, subscriptions, console)
# ---------------------------------------------------------------------------
# Stripe account of the PLATFORM company (tenants paying for the product).
# Separate from STRIPE_SECRET_KEY above (the club collecting from families).
STRIPE_BILLING_SECRET_KEY=sk_test_xxx
# Signing secret of the webhook endpoint -> https://<host>/api/billing/webhook
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxx
# Bearer token for GET /api/platform/cron/usage (daily usage snapshots)
CRON_SECRET=change-me-long-random-string
# NEXT_PUBLIC_PLATFORM_NAME (above) is also the product name on /signup and the platform console
# "Contact sales" address for Enterprise
PLATFORM_SALES_EMAIL=sales@example.com

# Stripe Connect (regional club payments) — each club is paid into its own account
# Connect webhook endpoint secret (events from connected accounts; event.account set)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_xxx
# "standard" (default) or "express"
STRIPE_CONNECT_ACCOUNT_TYPE=standard
# Express only: request the twint_payments capability for CH accounts
# (default true; "false" turns the request off)
STRIPE_CONNECT_REQUEST_TWINT=true
# "true" = refuse online payments for clubs without a connected account
# (unset = founding-club fallback: charge the platform account)
STRIPE_CONNECT_REQUIRED=false

# ---------------------------------------------------------------------------
# Additions — deployment & operations (see docs/ops/ARCHITECTURE_DEPLOYMENT.md)
# Every variable read anywhere in src/ is listed in this file. Validated by
# src/lib/observability/env-check.ts and `node scripts/deploy/check-env.mjs`.
# ---------------------------------------------------------------------------

# Sender actually read by src/lib/email/resend.ts. Must be on a domain verified
# in Resend (SPF + DKIM). RESEND_FROM_EMAIL above is kept for backwards compat.
RESEND_FROM="DLang Basketball <noreply@dlangbasketball.ch>"

# New-registration alerts go to each club's own admins (or the club's
# notification_email setting). There is no deployment-wide alert inbox.

# AI assistant (optional — the assistant is disabled when the key is empty).
# Platform switch only: each club must ALSO be on a plan that includes it
# (Club tier and up, or a founding club) and have an admin turn it on in
# Settings -> App & assistant (default off, audit-logged).
ANTHROPIC_API_KEY=
# Model identifier for the assistant (required together with the key; the
# assistant stays disabled when either is empty). Never hard-coded in src/.
ANTHROPIC_MODEL=

# Environment: local | staging | production. On Vercel it is inferred from
# VERCEL_ENV when unset, but set it explicitly in staging and production.
APP_ENV=local

# Data region served by THIS deployment: eu (Frankfurt — EU + CH tenants) | us
# (us-east-1). Must match the Supabase project configured above.
DATA_REGION=eu

# PLATFORM_ROOT_DOMAIN (white-label section above): root for <slug>.<root> tenant subdomains
# Public default tenant slug used by /legal and the cookie banner when no host match
NEXT_PUBLIC_DEFAULT_ORG_SLUG=dlang

# Logging: debug | info | warn | error (default info)
LOG_LEVEL=info

# Error reporting (optional). Any Sentry-compatible DSN (Sentry EU/US, GlitchTip).
# Leave empty to only write structured logs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Bearer token that unlocks config details on /api/health (min 16 chars).
# Generate with: openssl rand -hex 24
HEALTH_CHECK_TOKEN=

# Build identity. Set automatically on Vercel (VERCEL_GIT_COMMIT_SHA) and by
# the Dockerfile build args; only set manually for other hosts.
APP_VERSION=
GIT_SHA=

# Custom-domain automation via the Vercel Domains API (optional; server-only).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Public "Contact us" form (optional): secret for the salted hash of the client
# IP used by the rate limit (the IP itself is never stored). Falls back to
# CRON_SECRET when unset. Generate with: openssl rand -hex 24
CONTACT_FORM_SECRET=
