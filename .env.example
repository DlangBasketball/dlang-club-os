# ---------------------------------------------------------------------------
# DLang Basketball Club OS — environment template
# Copy to .env.local and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — used by the Stripe webhook & trusted server jobs.
# Must NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Payments — M5)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend (Transactional email — M12)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="DLang Basketball <noreply@dlangbasketball.ch>"

# For `npm run types` (Supabase type generation)
SUPABASE_PROJECT_ID=your-project-ref

# ---------------------------------------------------------------------------
# Additions — deployment & operations (see docs/ops/ARCHITECTURE_DEPLOYMENT.md)
# Every variable read anywhere in src/ is listed in this file. Validated by
# src/lib/observability/env-check.ts and `node scripts/deploy/check-env.mjs`.
# ---------------------------------------------------------------------------

# Sender actually read by src/lib/email/resend.ts. Must be on a domain verified
# in Resend (SPF + DKIM). RESEND_FROM_EMAIL above is kept for backwards compat.
RESEND_FROM="DLang Basketball <noreply@dlangbasketball.ch>"

# Inbox that receives "new registration" notifications (optional).
CLUB_ADMIN_EMAIL=admin@example.com

# AI assistant (optional — the assistant is disabled when the key is empty).
ANTHROPIC_API_KEY=
# Optional model identifier override; leave empty to use the built-in default.
ANTHROPIC_MODEL=

# Environment: local | staging | production. On Vercel it is inferred from
# VERCEL_ENV when unset, but set it explicitly in staging and production.
APP_ENV=local

# Data region served by THIS deployment: eu (Frankfurt — EU + CH tenants) | us
# (us-east-1). Must match the Supabase project configured above.
DATA_REGION=eu

# Root domain for tenant subdomains, e.g. clubos.app -> <slug>.clubos.app
PLATFORM_ROOT_DOMAIN=localhost

# Logging: debug | info | warn | error (default info)
LOG_LEVEL=info

# Error reporting (optional). Any Sentry-compatible DSN (Sentry EU/US, GlitchTip).
# Leave empty to only write structured logs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Bearer token that unlocks config details on /api/health (min 16 chars).
# Generate with: openssl rand -hex 24
HEALTH_CHECK_TOKEN=

# Build identity. Set automatically on Vercel (VERCEL_GIT_COMMIT_SHA) and by
# the Dockerfile build args; only set manually for other hosts.
APP_VERSION=
GIT_SHA=

# Custom-domain automation via the Vercel Domains API (optional; server-only).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
