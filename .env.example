# ---------------------------------------------------------------------------
# DLang Basketball Club OS — environment template
# Copy to .env.local and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — used by the Stripe webhook & trusted server jobs.
# Must NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Payments — M5)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend (Transactional email — M12)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="DLang Basketball <noreply@dlangbasketball.ch>"

# For `npm run types` (Supabase type generation)
SUPABASE_PROJECT_ID=your-project-ref
